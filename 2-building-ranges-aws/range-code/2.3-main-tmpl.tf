##########################################################################################
# PROVIDERS
##########################################################################################
# Configures the AWS provider plugin
provider "aws" {
  region = var.region # Sets AWS region using a variable for flexibility

  # Default tags get applied to all resources
  default_tags {
    tags = {
      Owner       = "CyberRanger" # "Dev", "Infra", "Data", "Security"
      Project     = var.project
      # Environment = var.environment
      Provisioned = "Terraform"
      # Are there any other default tags you would like to add?
    }
  }
}

##########################################################################################
# DATA Sources
##########################################################################################


##########################################################################################
# GENERIC RESOURCES
##########################################################################################
resource "random_string" "uid" {
  length  = 5
  special = false
  lower   = true
  upper   = false
  numeric = true
}

